{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eoe-symptom-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Cloudflare Access is the front door. Turn off the public *.workers.dev URL
  // and per-version preview URLs so nothing bypasses it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eoe-symptom-tracker",
      // Replace with the real id from `wrangler d1 create` at the deploy milestone.
      // Local dev uses a local SQLite file and ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
