{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eoe-symptom-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The app lives at its free *.workers.dev address, with Cloudflare Access
  // turned on for the Worker (Workers & Pages → the Worker → Access tab), so
  // only the allowed caregivers get through. Per-version preview URLs are off.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eoe-symptom-tracker",
      // Set by scripts/setup-cloudflare.sh. Local dev uses a local SQLite file and ignores it.
      "database_id": "b18138aa-d9cf-45af-b6f1-3a89e882bcc2",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Set by scripts/setup-cloudflare.sh, from Zero Trust. Until the AUD tag is set,
    // the Worker rejects every /api request.
    "ACCESS_TEAM_DOMAIN": "https://proud-dust-4dd0.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-the-access-application-aud-tag",
  },
  "observability": { "enabled": true },
}
